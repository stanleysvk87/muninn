# Muninn — konfigurácia. Skopíruj na .env (Docker) alebo do EnvironmentFile
# systemd unitu, nikdy necommituj vyplnenú verziu.

# --- Cesty (mimo Dockeru absolútne, v Dockeri podľa bind-mountu) ---
MUNINN_DATA_DIR=./data
MUNINN_ARCHIVE_DIR=./archive
MUNINN_DB_PATH=./data/muninn.db

# --- Server ---
MUNINN_PORT=8000
MUNINN_CORS_ORIGINS=

# --- Bezpecnost ---
# vygeneruj: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MUNINN_ENCRYPTION_KEY=
MUNINN_SESSION_TTL_DAYS=7
MUNINN_COOKIE_SECURE=true

# --- AI engine ---
# auto = skusi claude CLI, potom codex CLI, potom API kluc
MUNINN_AI_PROVIDER_MODE=auto
# vyplnit len ak MUNINN_AI_PROVIDER_MODE=anthropic_api alebo ako fallback
MUNINN_ANTHROPIC_API_KEY=

# --- Mail ingestion (volitelne, da sa nastavit aj cez UI) ---
MUNINN_MAIL_ENABLED=false
MUNINN_MAIL_HOST=
MUNINN_MAIL_PORT=993
MUNINN_MAIL_USERNAME=
MUNINN_MAIL_PASSWORD=

# --- Len Docker: kam na hoste mountnut data/archiv (docker-compose.yml) ---
MUNINN_DATA_HOST_PATH=./data
MUNINN_ARCHIVE_HOST_PATH=./archive
