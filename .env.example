# Muninn configuration. Copy to .env (Docker) or into the systemd unit's
# EnvironmentFile -- never commit the filled-in version.

# --- Paths (absolute outside Docker; inside Docker these are container-side
#     paths, matched by the bind mounts below) ---
MUNINN_DATA_DIR=./data
MUNINN_ARCHIVE_DIR=./archive
MUNINN_DB_PATH=./data/muninn.db

# --- Server ---
MUNINN_PORT=8000
MUNINN_CORS_ORIGINS=

# --- Security ---
# generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MUNINN_ENCRYPTION_KEY=
MUNINN_SESSION_TTL_DAYS=7
MUNINN_COOKIE_SECURE=true

# --- AI engine ---
# auto = try claude CLI, then codex CLI, then the API key below
MUNINN_AI_PROVIDER_MODE=auto
# only needed if MUNINN_AI_PROVIDER_MODE=anthropic_api, or as a fallback
MUNINN_ANTHROPIC_API_KEY=

# --- Mail ingestion (optional, can also be configured via the Settings UI) ---
MUNINN_MAIL_ENABLED=false
MUNINN_MAIL_HOST=
MUNINN_MAIL_PORT=993
MUNINN_MAIL_USERNAME=
MUNINN_MAIL_PASSWORD=

# --- Docker only: where on the host to mount data/archive (docker-compose.yml) ---
MUNINN_DATA_HOST_PATH=./data
MUNINN_ARCHIVE_HOST_PATH=./archive

# --- Docker only: reuse an existing claude/codex CLI login instead of an API
#     key (see INSTALL.md). Point these at the real binary path on the host;
#     leave unset to use an API key instead. ---
MUNINN_CLAUDE_BIN_HOST_PATH=
MUNINN_CODEX_BIN_HOST_PATH=

# --- Docker only, both optional: a shared CLAUDE.md location if ~/.claude/CLAUDE.md
#     on the host is a symlink into one, and a drop-zone watch folder. Leave
#     unset to default to small local placeholder directories instead of a
#     fixed host path -- see the comments in docker-compose.yml. ---
MUNINN_CLAUDE_GLOBAL_HOST_PATH=
MUNINN_CLAUDE_GLOBAL_CONTAINER_PATH=
MUNINN_WATCH_INBOX_HOST_PATH=
MUNINN_WATCH_INBOX_CONTAINER_PATH=
