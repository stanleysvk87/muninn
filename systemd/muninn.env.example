# Copy to /etc/muninn/muninn.env (chmod 600) and fill in. Same variables
# as the root .env.example, just with absolute paths suited to a
# /opt/muninn systemd deployment instead of a relative-path dev checkout.

MUNINN_DATA_DIR=/opt/muninn/backend/data
MUNINN_ARCHIVE_DIR=/opt/muninn/backend/archive
MUNINN_DB_PATH=/opt/muninn/backend/data/muninn.db
MUNINN_FRONTEND_DIST_DIR=/opt/muninn/frontend/dist

# The listening port for the systemd install comes from the unit's ExecStart
# (--port), NOT from this file -- uvicorn is started by systemd, and nothing in
# the app reads MUNINN_PORT. Change it in muninn.service and reload.
MUNINN_CORS_ORIGINS=
MUNINN_MAX_UPLOAD_MB=100

# generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MUNINN_ENCRYPTION_KEY=
MUNINN_SESSION_TTL_DAYS=7
MUNINN_COOKIE_SECURE=true

MUNINN_AI_PROVIDER_MODE=auto
MUNINN_ANTHROPIC_API_KEY=

# Mail/IMAP ingestion is configured in the app (Settings -> Mail) and nowhere
# else -- the MUNINN_MAIL_* variables that used to be listed here were read by
# no code at all.
